.DS_Store
node_modules/

# kane-cli local state — regenerated by `kane-cli context ingest`/`design`, never hand-edited
.context/

# Sealed evidence packs (screenshots, HAR, console logs) — large binaries, published to the
# KaneAI dashboard and to CI run artifacts instead of the git history
.testmuai/evidence/

# kane-cli variable/context overrides that may hold local secrets
.testmuai/variables/
.testmuai/context.md

# Per-run debug output (regenerated on every testmd/testrun execution)
.testmuai/tests/output-*/

# Generated proof dashboard — rebuilt every run by scripts/render-assurance-dashboard.js,
# uploaded as a CI artifact instead of committed
/assurance-report.html

